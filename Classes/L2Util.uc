}

function getCastleNameExData()
{
    local int i;
    local string castleParam;
    local array<string> castleParamArr, locParamArr;
    local string locParam;
    local int regionId;
    local sCastleName tmpCastleData, clearCaslteData;

    // End:0x0E
    if(castleData.Length > 0)
    {
        return;
    }
    i = 1;
    J0x15:

    // End:0x1E2 [Loop If]
    if(i < 1000)
    {
        tmpCastleData = clearCaslteData;
        GetINIString("castle", "castle_id" $ string(i), castleParam, "CastleDataEx.dat");
        // End:0x78
        if(Len(castleParam) <= 0)
        {
            // [Explicit Continue]
            goto J0x1D8;
        }
        castleParamArr = Arr(castleParam, "t");
        tmpCastleData.Id = i;
        ParseInt(castleParam, "region_id", tmpCastleData.region_id);
        // End:0xCF
        if(tmpCastleData.region_id <= 0)
        {
            // [Explicit Continue]
            goto J0x1D8;
        }
        ParseString(castleParam, "loc", locParam);
        // End:0xF4
        if(Len(locParam) <= 0)
        {
            // [Explicit Continue]
            goto J0x1D8;
        }
        locParamArr = Arr(locParam, ";");
        tmpCastleData.loc.X = float(int(locParamArr[0]));
        tmpCastleData.loc.Y = float(int(locParamArr[1]));
        tmpCastleData.loc.Z = float(int(locParamArr[2]));
        GetINIString("castle", "castle_name" $ string(tmpCastleData.Id), tmpCastleData.Name, getCastleLocalization());
        // End:0x1D8
        if(((tmpCastleData.region_id > 0) && Len(locParam) > 0) && Len(tmpCastleData.Name) > 0)
        {
            castleData[castleData.Length] = tmpCastleData;
        }
        J0x1D8:

        i++;
        // [Loop Continue]
        goto J0x15;
    }
    return;
}
