function array<ItemInfo> sortByName(array<ItemInfo> itemList)
{
    local int Len;
    local ItemInfo temp;
    local int i, j;

    Len = itemList.Length;
    i = 0;
    J0x13:

    // End:0xCE [Loop If]
    if(i < Len)
    {
        j = 0;
        J0x29:

        // End:0xC4 [Loop If]
        if(j < (Len - i))
        {
            // End:0xBA
            if(j < (Len - 1))
            {
                // End:0xBA
                if((GetItemNameWithAdditional(itemList[j])) > (GetItemNameWithAdditional(itemList[j + 1])))
                {
                    temp = itemList[j];
                    itemList[j] = itemList[j + 1];
                    itemList[j + 1] = temp;
                }
            }
            ++j;
            // [Loop Continue]
            goto J0x29;
        }
        ++i;
        // [Loop Continue]
        goto J0x13;
    }
    return itemList;
    return;
}

