        // End:0x5F
        case 0:
            Info.t_color.R = byte(255);
            Info.t_color.G = byte(255);
            Info.t_color.B = byte(255);
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0xB1
        case 1:
            Info.t_color.R = 163;
            Info.t_color.G = 163;
            Info.t_color.B = 163;
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0x103
        case 2:
            Info.t_color.R = 176;
            Info.t_color.G = 155;
            Info.t_color.B = 121;
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0x155
        case 3:
            Info.t_color.R = 240;
            Info.t_color.G = 214;
            Info.t_color.B = 54;
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0x1A9
        case 4:
            Info.t_color.R = byte(255);
            Info.t_color.G = 204;
            Info.t_color.B = 0;
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0x1FB
        case 5:
            Info.t_color.R = 250;
            Info.t_color.G = 50;
            Info.t_color.B = 0;
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0x24D
        case 6:
            Info.t_color.R = 100;
            Info.t_color.G = 100;
            Info.t_color.B = 250;
            Info.t_color.A = byte(255);
            // End:0x253
            break;
        // End:0xFFFF
        default:
            // End:0x253
            break;
            break;
    }
    return Info;
    return;
}

function TwoWordCombineColon(string word1, string word2, optional L2Util.ETooltipTextType e1, optional L2Util.ETooltipTextType e2, optional bool bLineBreak, optional int OffsetX, optional int OffsetY)
{
    ToopTipInsertText(word1, false, bLineBreak, e1, OffsetX, OffsetY);
    ToopTipInsertText(" : ", false, false, 1, OffsetX, OffsetY);
    ToopTipInsertText(word2, false, false, e2, OffsetX, OffsetY);
    return;
}

