function bool isWarningCondition(int op1, int op2)
{
    // End:0x40
    if((((IsSTR(op1)) || IsINT(op1)) || IsCON(op1)) || IsMEN(op1))
    {
        return true;
    }
    // End:0x1C0
    if((((((((((((((((((((((((IsHealActive(op2)) || IsPurpleLifeStone(op2)) || IsRedLifeStone(op2)) || IsPrayerActive(op2)) || IsRitualActive(op2)) || IsDuelMightActive(op2)) || IsPhysicalDefenceActive(op2)) || IsMagicDefenceActive(op2)) || IsHealEmpowerActive(op2)) || IsEvasionActive(op2)) || IsAccuracyActive(op2)) || IsFocusActive(op2)) || IsWildMagicActive(op2)) || IsReturnActive(op2)) || IsInstantReturnActive(op2)) || IsVampiricRageActive(op2)) || IsHateActive(op2)) || IsManaBurnActive(op2)) || IsResurrectActive(op2)) || IsPhysicalClarityActive(op2)) || IsMagicalClarityActive(op2)) || IsDanceSongClarityActive(op2)) || IsAllClarityActive(op2)) || IsReflectActive(op2))
    {
        return true;
    }
    // End:0x210
    if(((((IsParalyzeActive(op2)) || IsMedusaActive(op2)) || IsFearActive(op2)) || IsSilenceActive(op2)) || IsDoomActive(op2))
    {
        return true;
    }
    // End:0x2D0
    if((((((((((((IsDrainActive(op2)) || IsFireActive(op2)) || IsWaterActive(op2)) || IsWindActive(op2)) || IsEarthActive(op2)) || IsHolyActive(op2)) || IsUnholyActive(op2)) || IsNonAttrActive(op2)) || IsPhysicalRefreshActive(op2)) || IsMagicalRefreshActive(op2)) || IsAllRefreshActive(op2)) || IsCelestial(op2))
    {
        return true;
    }
    // End:0x360
    if(((((((((IsAuraFlareActive(op2)) || IsShadowFlareActive(op2)) || IsBleedActive(op2)) || IsBattleRoarActive(op2)) || IsManaGainActive(op2)) || IsRecallActive(op2)) || IsTrickActive(op2)) || IsStealthActive(op2)) || IsMusicRefreshActive(op2))
    {
        return true;
    }
    // End:0x450
    if(((((((((((((((IsPrayerPassive(op2)) || IsDuelMightPassive(op2)) || IsPhysicalDefencePassive(op2)) || IsMagicalDefencePassive(op2)) || IsHealEmpowerPassive(op2)) || IsEvasionPassive(op2)) || IsAccuracyPassive(op2)) || IsFocusPassive(op2)) || IsWildMagicPassive(op2)) || IsPhysicalClarityPassive(op2)) || IsMagicalClarityPassive(op2)) || IsDanceSongClarityPassive(op2)) || IsAllClarityPassive(op2)) || IsReflectPassive(op2)) || IsWeightLimitPassive(op2))
    {
        return true;
    }
    // End:0x4F0
    if((((((((((IsAttackSlowChance(op2)) || IsAttackWinterChance(op2)) || IsAttackStunChance(op2)) || IsAttackHoldChance(op2)) || IsAttackParalyzeChance(op2)) || IsAttackMedusaChance(op2)) || IsAttackFearChance(op2)) || IsAttackBleedChance(op2)) || IsAttackSilenceChance(op2)) || IsAttackDoomChance(op2))
    {
        return true;
    }
    // End:0x590
    if((((((((((IsCriticalSlowChance(op2)) || IsCriticalWinterChance(op2)) || IsCriticalStunChance(op2)) || IsCriticalHoldChance(op2)) || IsCriticalParalyzeChance(op2)) || IsCriticalMedusaChance(op2)) || IsCriticalFearChance(op2)) || IsCriticalBleedChance(op2)) || IsCriticalSilenceChance(op2)) || IsCriticalDoomChance(op2))
    {
        return true;
    }
    // End:0x630
    if((((((((((IsMagicSlowChance(op2)) || IsMagicWinterChance(op2)) || IsMagicStunChance(op2)) || IsMagicHoldChance(op2)) || IsMagicParalyzeChance(op2)) || IsMagicMedusaChance(op2)) || IsMagicFearChance(op2)) || IsMagicBleedChance(op2)) || IsMagicSilenceChance(op2)) || IsMagicDoomChance(op2))
    {
        return true;
    }
    // End:0x6D0
    if((((((((((IsDefenceSlowChance(op2)) || IsDefenceWinterChance(op2)) || IsDefenceStunChance(op2)) || IsDefenceHoldChance(op2)) || IsDefenceParalyzeChance(op2)) || IsDefenceMedusaChance(op2)) || IsDefenceFearChance(op2)) || IsDefenceBleedChance(op2)) || IsDefenceSilenceChance(op2)) || IsDefenceDoomChance(op2))
    {
        return true;
    }
    // End:0x760
    if(((((((((IsManaBurnChance(op2)) || IsMagicBarrierChance(op2)) || IsDuelMightChance(op2)) || IsGuidanceChance(op2)) || IsPoisonChance(op2)) || IsManaGainChance(op2)) || IsSleepChance(op2)) || IsBlessedBodyChance(op2)) || IsBlessedSoulChance(op2))
    {
        return true;
    }
    return false;
    return;
}
