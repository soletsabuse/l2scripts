<Window x:Class="PvePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PvE Panel" Width="1400" Height="900" MinWidth="1060" MinHeight="660"
        Background="#0A0D12" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- the page of the panel (pve.html) - the same as in the browser -->
        <wv2:WebView2 x:Name="Web" />

        <!-- the server is down / the page cannot be shown -->
        <Border x:Name="Down" Background="#0A0D12" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock x:Name="DownTitle" Text="PvE server not running" Foreground="#E6EBF2" FontSize="22"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="DownText" Foreground="#8893A4" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,10,0,20"
                           Text="The server is built into the panel (port 7800). The page needs it: it reads and writes the farm's files through it." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="StartBtn" Content="Start server" Padding="18,8" Click="StartBtn_Click" />
                    <Button x:Name="BrowserBtn" Content="Open in browser" Padding="18,8" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="BrowserBtn_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
